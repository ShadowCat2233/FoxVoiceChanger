<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FoxVoice</AssemblyName>
    <RootNamespace>FoxVoice.Desktop</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\native\target\release\foxvoice-supervisor.exe"
                      LogicalName="FoxVoice.Native.foxvoice-supervisor.exe"
                      Condition="Exists('..\..\native\target\release\foxvoice-supervisor.exe')" />
    <EmbeddedResource Include="..\..\native\target\release\foxvoice-engine.exe"
                      LogicalName="FoxVoice.Native.foxvoice-engine.exe"
                      Condition="Exists('..\..\native\target\release\foxvoice-engine.exe')" />
    <EmbeddedResource Include="..\..\native\target\release\foxvoice-converter.exe"
                      LogicalName="FoxVoice.Native.foxvoice-converter.exe"
                      Condition="Exists('..\..\native\target\release\foxvoice-converter.exe')" />
  </ItemGroup>
</Project>
