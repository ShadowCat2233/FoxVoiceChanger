<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FoxVoiceSetup</AssemblyName>
    <RootNamespace>FoxVoice.Setup</RootNamespace>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(PayloadPath)')">
    <EmbeddedResource Include="$(PayloadPath)" LogicalName="FoxVoice.Payload.zip" />
  </ItemGroup>
</Project>
